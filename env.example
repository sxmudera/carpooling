PORT=3000
NODE_ENV=development

# MySQL (lokal)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carpooling_db
DB_USER=root
DB_PASS=yourpassword

# MySQL (Cloud Run + Cloud SQL) — jangan set DB_HOST=localhost
# Di Cloud Run: Connections > Cloud SQL > pilih instance
# Lalu set secret/env:
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name
# DB_NAME, DB_USER, DB_PASS (user MySQL di Cloud SQL)

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/carpooling_nosql?retryWrites=true&w=majority

# JWT
JWT_SECRET=ganti_ini_dengan_string_random
JWT_EXPIRES_IN=7d
